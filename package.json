{
  "name": "nimfind",
  "version": "0.1.0",
  "private": true,
  "description": "Lost and found QR tags and lock screen wallpapers for Nimiq Pay, with finder rewards paid in NIM.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx server/dev.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "vercel-build": "npm run build && tsx scripts/migrate.ts && node scripts/build-vercel.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && vue-tsc -p web/tsconfig.json --noEmit",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/mulish": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@nimiq/hub-api": "^1.15.0",
    "@nimiq/mini-app-sdk": "^0.1.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "hono": "^4.13.8",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@nimiq/core": "^2.21.0",
    "@types/node": "^22.20.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "esbuild": "^0.28.2",
    "nimiq-icons": "^1.0.0-beta.162",
    "tsx": "^4.23.13",
    "typescript": "~5.9",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
